pipeline {
    agent {
        docker {
            image 'maven:3.10.0-eclipse-temurin-27'

             // Connect the Maven container to the same network as the application and database.
             // Mount a persistent volume to cache Maven dependencies between builds.
            args '--network=beer-info-network -v maven_cache_for_jenkins:/root/.m2'
        }
    }

    // Load Docker-specific configuration
    environment {
        APP_ENV = 'docker'
    }

    stages {
        stage('Environment') {
            steps {
                sh '''
                    java --version
                    mvn --version
                    pwd
                    ls -la
                '''
            }
        }

        stage('Dependencies') {
            steps {
                sh 'mvn dependency:go-offline'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn clean test'
            }
        }

        stage('Allure Report') {
            steps {
                junit 'target/surefire-reports/*.xml'
                allure(
                    includeProperties: false,
                    jdk: '',
                    results: [[path: 'target/allure-results']]
                )
            }
        }
    }
}